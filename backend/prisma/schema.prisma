// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  summaries    Summary[]
}

enum SummaryStatus {
  COMPLETED
  FAILED
}

model Summary {
  id                String        @id @default(cuid())
  userId            String
  sourceType        String        @default("TEXT")
  sourceUrl         String?       @db.Text
  inputText         String        @db.Text
  requestedWordLimit Int
  summaryText       String?       @db.Text
  status            SummaryStatus @default(COMPLETED)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiModelRun        AiModelRun?

  @@index([userId, createdAt])
}

model AiModelRun {
  id                String   @id @default(cuid())
  summaryId         String   @unique
  provider          String
  model             String
  modelVersion      String?
  durationMs        Int
  inputCharacters   Int
  outputWords       Int
  promptTokens      Int?
  completionTokens  Int?
  totalTokens       Int?
  createdAt         DateTime @default(now())

  summary           Summary  @relation(fields: [summaryId], references: [id], onDelete: Cascade)
}